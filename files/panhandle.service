# panhandle is a LANL HPC-developed binary designed for monitoring user input
# see `man panhandle` or `panhandle --help` for more information
# this service file is distributed by the panhandle rpm
[Unit]
Description=Run the panhandle binary via systemd
Documentation=https://github.com/lanl/panhandle
Requires=network-online.target
After=network-online.target

[Service]
Type=simple
Restart=on-failure
TimeoutSec=5
ExecStart=/usr/sbin/panhandle --config /opt/panhandle/panhandle.yaml
StandardOutput=append:/var/log/panhandle/panhandle.log
StandardError=append:/var/log/panhandle/panhandle_error.log

# panhandle runs as full root: loading eBPF programs and LSM hooks, taskstats
# netlink queries, and reading every process's /proc entries haven't been narrowed
# down to a minimal CAP_BPF/CAP_PERFMON/CAP_SYS_ADMIN set across every RHEL9/10 and
# SLE15 target this is packaged for, so capabilities aren't restricted here. These
# three directives are still safe to set unconditionally:
# panhandle never execs another binary, never touches /home, and never writes to
# /tmp, so none of them can affect its actual behavior.
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
