#!/bin/bash
# Install git pre-commit hooks for linting
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

echo "=== Installing git hooks ==="

# Pre-commit hook
cat > "$PROJECT_ROOT/.git/hooks/pre-commit" << 'EOF'
#!/bin/bash
# Pre-commit hook: run quick linting
set -euo pipefail

echo "=== Running pre-commit checks ==="

# Get project root
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Quick Rust fmt check
echo "Checking Rust formatting..."
cd "$ROOT/panhandle"
if ! cargo fmt --all -- --check 2>/dev/null; then
    echo "Error: Code not formatted. Run 'cargo fmt --all' in panhandle/"
    exit 1
fi

# Quick clippy check (no --fix)
echo "Running clippy..."
if ! cargo clippy --all-targets --all-features -- -D warnings -A clippy::too_many_arguments 2>/dev/null; then
    echo "Error: Clippy found issues. Run './scripts/lint' to fix"
    exit 1
fi

# Quick markdownlint check
echo "Checking markdown..."
cd "$ROOT"
if ! npx markdownlint '**/*.md' --ignore node_modules --ignore archive 2>/dev/null; then
    echo "Error: Markdown linting failed. Run './scripts/lint' to fix"
    exit 1
fi

# Quick yamllint check (errors only)
echo "Checking YAML..."
if yamllint -c .yamllint.yaml . 2>/dev/null | grep -E "\[error\]" | grep -v "node_modules" | grep -v "archive" | grep -v ".gitlab-ci.yml" | grep -q .; then
    echo "Error: YAML linting failed. Run './scripts/lint' to fix"
    exit 1
fi

# Check for TODO/FIXME in staged files
echo "Checking for TODO/FIXME in staged files..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(rs|md|yaml|yml|toml|sh)$' || true)
if [[ -n "$STAGED_FILES" ]]; then
    if echo "$STAGED_FILES" | xargs grep -l "TODO\|FIXME" 2>/dev/null; then
        echo "Warning: Staged files contain TODO/FIXME comments"
    fi
fi

echo "=== Pre-commit checks passed! ==="
EOF

chmod +x "$PROJECT_ROOT/.git/hooks/pre-commit"

# Pre-push hook
cat > "$PROJECT_ROOT/.git/hooks/pre-push" << 'EOF'
#!/bin/bash
# Pre-push hook: run full test suite
set -euo pipefail

echo "=== Running pre-push checks ==="

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/panhandle"

echo "Running tests..."
if ! cargo test 2>/dev/null; then
    echo "Error: Tests failed"
    exit 1
fi

echo "Running cargo deny check..."
if ! cargo deny check 2>/dev/null; then
    echo "Error: cargo deny check failed"
    exit 1
fi

echo "=== Pre-push checks passed! ==="
EOF

chmod +x "$PROJECT_ROOT/.git/hooks/pre-push"

echo "=== Git hooks installed! ==="
echo "  - .git/hooks/pre-commit (fmt, clippy, markdownlint, yamllint)"
echo "  - .git/hooks/pre-push (tests, cargo deny)"
echo ""
echo "To bypass hooks temporarily: git commit --no-verify / git push --no-verify"