{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "panhandle": {
      "path": ".",
      "description": "Panhandle project - eBPF user activity monitoring for HPC"
    },
    "aya-github": {
      "path": "~/.local/share/opencode/repos/github.com/aya-rs/aya",
      "description": "Official Aya library GitHub repository - latest eBPF development in Rust"
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "cargo *": "allow",
      "git *": "allow",
      "make *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "sed *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "rustc *": "allow",
      "clippy *": "allow",
      "fmt *": "allow",
      "check *": "allow",
      "build *": "allow",
      "test *": "allow",
      "bench *": "allow",
      "doc *": "allow",
      "audit *": "allow",
      "tarpaulin *": "allow",
      "bpf-linker *": "allow",
      "rm -rf *": "deny",
      ":; *": "deny",
      "sudo *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "mv * /": "deny",
      "cp * /": "deny",
      "* > *": "ask",
      "* >> *": "ask",
      "*": "ask"
    },
    "external_directory": {
      "~/.cargo/**": "allow",
      "~/.rustup/**": "allow",
      "~/.local/share/opencode/**": "allow",
      "/usr/lib/**": "allow",
      "/usr/share/**": "allow",
      "/usr/local/**": "allow",
      "/usr/include/**": "allow",
      "/usr/bin/**": "allow",
      "/opt/**": "allow",
      "/tmp/**": "allow",
      "/proc/**": "allow",
      "/sys/**": "allow",
      "./**": "allow",
      "*": "ask"
    }
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 32768
  },
  "experimental": {
    "primary_tools": ["edit", "read", "glob", "grep", "bash", "lsp_diagnostics"],
    "mcp_timeout": 300000
  }
}
